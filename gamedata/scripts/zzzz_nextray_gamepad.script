-- neXt-Ray gamepad support for GAMMA's mods (in the engine's gamedata). The original mods stay untouched: a mod's
-- function is changed at runtime only when its source text is exactly the known one (other executables, or another
-- version of the mod, run it as it is, with one log line); the wheel's buttons press the mods' own keys.
--
-- 1. Catspaw's mods (Interaction Dot Marks, Fair Fast Travel, Milspec PDA...): utils_catspaw_text.bindtext names a
--    key by MCM's own table (ui_mcm.display_key), "F" for the use key also with the gamepad in use. While texts name
--    the gamepad's buttons, a key bound to an action is named by its gamepad button, as the engine names it in texts
--    ($$ACTION_use$$); modifiers (Shift, Ctrl, Alt) and keys of no action keep their names.
-- 2. The wheel's buttons (LB held by default: the wheel takes out the slots, the other buttons do these, each chosen
--    in the gamepad options from the catalog below): the mods' actions a gamepad has no button for, as the engine's custom actions their scripts listen to (key_bindings.kCUSTOM...,
--    pressed as if by their key, bound or not) or a mod's MCM key (pressed with its modifier, tapped twice or held as
--    its MCM settings want). Only those whose mod is there (its script) and whose key is bound (MCM); each on its own
--    button, shown beside the wheel.
-- 3. The menu cursor's targets in GAMMA's inventory (its item cells).
-- 4. Mods' keys the buttons press as the keyboard's do: the reload button unjams a jammed weapon (GAMMA's reload key is
--    arti_jamming's unjam one), the jump button holds Ledge Grabbing's key (it reads its own key, not the jump action),
--    the laser action (key_bindings.kWPN_LASER, RB tapped twice) switches the weapon's laser as the torch key held does
--    (zzz_bas_laser_control).
-- 5. Beef's NVG by the night vision button held (RB): off, it switches on at once; on, it switches off when the button
--    is released, unless D-pad up or down was pressed meanwhile: those step its brightness up and down. (The mod's
--    own key steps the brightness when tapped and switches when held 0.25 s; a button's held key comes after the
--    hold time already, so its tap couldn't be done.)

local function msg(fmt, ...)
	log(string.format("[neXt-Ray gamepad] " .. fmt, ...))
end

---------------------------------------------------------------------------------------------------------------------
-- 1. utils_catspaw_text.bindtext

local modifiers = { [DIK_keys.DIK_LSHIFT] = true, [DIK_keys.DIK_LCONTROL] = true, [DIK_keys.DIK_LMENU] = true }

local function catspaw_patch()
	local m = utils_catspaw_text
	local native = gamepad_key_prompt
	if not (native and m and type(m.bindtext) == "function" and debug and debug.getupvalue) then return false end
	local fp = zzzz_nextray_load.source_hash(m.bindtext)
	if fp ~= "808:743618750" then
		msg("utils_catspaw_text.bindtext is not the known one (%s), kept", tostring(fp))
		return false
	end
	local i = 1
	while true do
		local name, key_name = debug.getupvalue(m.bindtext, i)
		if not name then return false end
		if name == "DIK_name" and type(key_name) == "function" then
			debug.setupvalue(m.bindtext, i, function(dik)
				local pad = (not modifiers[dik]) and type(dik) == "number" and native(dik)
				if pad and pad ~= "" then
					return pad
				end
				return key_name(dik)
			end)
			return true
		end
		i = i + 1
	end
end

---------------------------------------------------------------------------------------------------------------------
-- 2. The wheel's buttons

local function has_script(name)
	return getFS():exist("$game_scripts$", name .. ".script") ~= nil
end

-- The actions the wheel's buttons can do (Options > Modded Exes > Controls > Gamepad, the wheel's rows), by id.
-- label: a string id; action: the engine's action, or mcm: a key's MCM path (mod, mode: its modifier and press type's
-- paths); script: a script of the mod (the action shown only when it's there)
catalog = {
	lower_weapon = { label = "st_gp_wheel_lower_weapon", action = "kSAFEMODE", script = "lower_weapon_sprint" },
	quick_melee = { label = "st_gp_wheel_quick_melee", action = "kCUSTOM24", script = "quickdraw" },
	suppressor = { label = "st_gp_wheel_suppressor", action = "kCUSTOM13", script = "item_weapon" },
	unload_all = { label = "st_gp_wheel_unload_all", action = "kCUSTOM15", script = "item_weapon" },
	unjam = { label = "st_gp_wheel_unjam", action = "kCUSTOM22", script = "arti_jamming" },
	companions = { label = "st_gp_wheel_companions", action = "kCUSTOM18", script = "ui_addon_companion_quick_menu" },
	map = { label = "st_gp_wheel_map", action = "kCUSTOM20", script = "actor_effects" },
	hud = { label = "st_gp_wheel_hud", action = "kCUSTOM6", script = "actor_effects" },
	health = { label = "st_gp_wheel_health", mcm = "body_health_system/hud_toggle_key_bind",
		script = "zzz_player_injuries_mcm" },
	laser_settings = { label = "st_gp_wheel_laser_settings", mcm = "laser_settings/config_key",
		script = "laser_settings_mcm" },
	furniture_mode = { label = "st_gp_wheel_furniture_mode", mcm = "aol_hf/controls/bind_place_mode",
		script = "placeable_furniture" },
	skills = { label = "st_gp_wheel_skills", mcm = "skill_system/ui_keybind", mod = "skill_system/modifier",
		script = "haru_skills" },
	patches = { label = "st_gp_wheel_patches", mcm = "patches_by_hotkey/key", script = "patches_by_hotkey_mcm" },
	exo_power = { label = "st_gp_wheel_exo_power", mcm = "exo_power/keybind", mod = "exo_power/second_key",
		mode = "exo_power/modifier", script = "exo_power_activator_mcm" },
	minimap = { label = "st_gp_wheel_minimap", mcm = "rax_mmt/keybind", mod = "rax_mmt/modifier", mode = "rax_mmt/mode",
		script = "mini_map_toggle_mcm" },
	reticle = { label = "st_gp_wheel_reticle", mcm = "3d_scopes/mark_switch/keybind",
		mod = "3d_scopes/mark_switch/modifier", mode = "3d_scopes/mark_switch/press_type", script = "z_mark_switch" },
}
-- The options' list order ("none": the button does nothing while the wheel is held)
catalog_order = { "none", "lower_weapon", "quick_melee", "suppressor", "unload_all", "unjam", "companions",
	"map", "hud", "health", "laser_settings", "furniture_mode", "skills", "patches", "exo_power", "minimap", "reticle" }

-- The wheel's buttons (LB opens it: the others) and their actions by default; the choice kept in axr_options.ltx
wheel_buttons = { "gpA", "gpB", "gpX", "gpY", "gpDPAD_UP", "gpDPAD_DOWN", "gpDPAD_LEFT", "gpDPAD_RIGHT" }
local wheel_default = {
	gpA = "lower_weapon", gpB = "patches", gpX = "skills", gpY = "laser_settings",
	gpDPAD_UP = "exo_power", gpDPAD_DOWN = "suppressor", gpDPAD_LEFT = "companions", gpDPAD_RIGHT = "map",
}
local WHEEL_SECTION = "nextray_gamepad_wheel"

function wheel_get(button)
	local id = axr_main.config:r_value(WHEEL_SECTION, button, 0, wheel_default[button] or "none")
	return (id == "none" or catalog[id]) and id or (wheel_default[button] or "none")
end

function wheel_set(button, id)
	if not (id == "none" or catalog[id]) then return end
	axr_main.config:w_value(WHEEL_SECTION, button, id)
	axr_main.config:save()
end

local shown = {} -- the buttons' entries as the wheel opened

local function mcm_get(path)
	return ui_mcm and ui_mcm.get and ui_mcm.get(path)
end

local function available(e)
	if e.script and not has_script(e.script) then
		return false
	end
	if e.mcm then
		local key = mcm_get(e.mcm)
		return type(key) == "number" and key > 0
	end
	return key_bindings[e.action] ~= nil
end

-- A mod's MCM key: with its modifier, tapped twice (press type 1) or held past MCM's hold time (2)
local function press_mcm(e)
	local key = mcm_get(e.mcm)
	local mod = e.mod and tonumber(mcm_get(e.mod)) or 0
	local mode = e.mode and tonumber(mcm_get(e.mode)) or 0
	local mod_dik = ({ DIK_keys.DIK_LSHIFT, DIK_keys.DIK_LCONTROL, DIK_keys.DIK_LMENU })[mod] or 0
	local tap_ms = tonumber(mcm_get("mcm/mcm_kb/mcm_kb_main/dtaptime2")) or 200
	local hold = 0
	if mode == 2 then
		hold = (tonumber(mcm_get("mcm/mcm_kb/mcm_kb_main/presstime")) or 2) * tap_ms * 1.3 / 1000
	end
	gamepad_press_key(key, mod_dik, mode == 1 and 2 or 1, hold)
end

function action_wheel_open()
	shown = {}
	for _, button in ipairs(wheel_buttons) do
		local e = catalog[wheel_get(button)]
		if e and available(e) then
			shown[#shown + 1] = e
			gamepad_wheel_add(button, e.label)
		end
	end
end

function action_wheel_choose(i)
	local e = shown[i]
	if not e then
		return
	end
	if e.mcm then
		press_mcm(e)
	else
		gamepad_send_action(key_bindings[e.action])
	end
end

---------------------------------------------------------------------------------------------------------------------
-- 3. The menu cursor's targets: GAMMA's inventory (utils_ui, ui_inventory.GUI: also trade, loot, stashes) draws its
--    item cells as plain statics; their windows, those shown, are given to the engine (gamepad_menu_target)

function menu_targets()
	local gui = ui_inventory and ui_inventory.GUI
	if not (gui and gui.IsShown and gui:IsShown() and type(gui.CC) == "table") then
		return
	end
	for _, cc in pairs(gui.CC) do
		if type(cc.cell) == "table" then
			for _, ci in pairs(cc.cell) do
				if ci.cell and ci:IsShown() then
					gamepad_menu_target(ci.cell)
				end
			end
		end
	end
end

---------------------------------------------------------------------------------------------------------------------
-- 4. Mods' keys by the buttons

-- Ledge Grabbing (demonized_ledge_grabbing) acts on its own key (MCM, Space as the jump's) and reads whether it's held:
-- kept down while a gamepad button bound to the jump is
local ledge_button, ledge_key = nil, nil

local function is_gamepad_key(dik)
	return gamepad_key_prompt ~= nil and dik >= 400 and dik < 500
end

-- The weapon's laser (Laser Settings / BAS, zzz_bas_laser_control): the torch key held for 0.5 s there, with a weapon
-- that has one in hands, idle, and the HUD free; the same conditions here
local function laser_toggle()
	local m = zzz_bas_laser_control
	if not (m and m.toggle_laser and m.has_laser and db.actor) then return end
	if device():is_paused() or not actor_menu.is_hud_free() then return end
	local wpn = db.actor:active_item()
	if wpn and m.has_laser(wpn:section()) and wpn:get_state() == 0 then
		m.toggle_laser(wpn:id())
	end
end

local function on_key_press(dik)
	if key_bindings.kWPN_LASER and is_gamepad_key(dik) and dik_to_bind(dik) == key_bindings.kWPN_LASER then
		laser_toggle()
		return
	end
	if ledge_button or not (is_gamepad_key(dik) and dik_to_bind(dik) == key_bindings.kJUMP) then return end
	local key = has_script("demonized_ledge_grabbing") and mcm_get("demonized_ledge_grabbing/keybind")
	if type(key) == "number" and key > 0 then
		ledge_button, ledge_key = dik, key
		gamepad_key(key, true)
	end
end

local function on_key_release(dik)
	if dik == ledge_button then
		gamepad_key(ledge_key, false)
		ledge_button, ledge_key = nil, nil
	end
end

---------------------------------------------------------------------------------------------------------------------
-- 5. Night vision (item_device, z_beefs_nvgs)

local nv_switched = false -- the press switched it on: the release leaves it

local function nv_mod()
	return item_device and item_device.set_nightvision and z_beefs_nvgs and z_beefs_nvgs.brightness_adjust
end

-- As item_device's key held does
local function nv_toggle()
	if not (nv_mod() and db.actor) then return end
	local torch = db.actor:item_in_slot(10)
	z_beefs_nvgs.play_animation = true
	item_device.set_nightvision(torch and torch:section(), not item_device.nv_state)
end

function nv_press()
	nv_switched = false
	if nv_mod() and not item_device.nv_state then
		nv_toggle()
		nv_switched = true
	end
end

function nv_release(used)
	if not nv_switched and not used then
		nv_toggle()
	end
end

-- The mod's brightness_adjust steps the way its gain_directionality says (up to the maximum, then down): set here to
-- the D-pad's direction before each step
function nv_brightness(dir)
	if not (nv_mod() and item_device.nv_state and debug and debug.getupvalue) then return end
	local f = z_beefs_nvgs.brightness_adjust
	local i = 1
	while true do
		local name = debug.getupvalue(f, i)
		if not name then break end
		if name == "gain_directionality" then
			debug.setupvalue(f, i, dir > 0)
			break
		end
		i = i + 1
	end
	f()
end

---------------------------------------------------------------------------------------------------------------------

function on_game_start()
	local catspaw_on = catspaw_patch()
	msg("Catspaw's key names by the gamepad %s", catspaw_on and "on" or "off")
	if gamepad_unjam_action then
		gamepad_unjam_action(has_script("arti_jamming") and key_bindings.kCUSTOM22 or 0)
	end
	if gamepad_nv_script then
		gamepad_nv_script(has_script("z_beefs_nvgs") and has_script("item_device"))
	end
	if gamepad_key then
		RegisterScriptCallback("on_key_press", on_key_press)
		RegisterScriptCallback("on_key_release", on_key_release)
	end
end
