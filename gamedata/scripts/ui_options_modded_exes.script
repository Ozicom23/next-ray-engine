--- Options menu extension

-- Steam Deck preset: lowers the settings whose loss is hard to see on the Deck's 800p screen. Turning it on
-- remembers the current values (axr_options, section deck_preset) and turning it off restores them, so the
-- two can be compared. Each entry only ever lowers a setting: values already lower are left alone.
--   index: position in a vector setting (1-based), nil for a plain value
--   value: the preset value; mode "max" keeps the larger of current and preset (resolution divisors),
--          "min" the smaller (sample counts, distances, quality scales)
local deck_preset = {
	{ cmd = "ssfx_ao",              index = 1, value = 2,   mode = "max" }, -- ambient occlusion at half resolution
	{ cmd = "ssfx_ssr",             index = 1, value = 2,   mode = "max" }, -- screen space reflections at half resolution
	{ cmd = "ssfx_sss_quality",     index = 1, value = 8,   mode = "min" }, -- screen space sun shadow samples
	{ cmd = "ssfx_sss_quality",     index = 2, value = 3,   mode = "min" }, -- screen space shadow samples, other lights
	{ cmd = "ssfx_shadow_cascades", index = 3, value = 140, mode = "min" }, -- far sun shadow cascade, metres
	{ cmd = "r2_ls_squality",                  value = 0.75, mode = "min" }, -- point and spot light shadow map size
	{ cmd = "r4_sun_smap_scale",    index = 2, value = 0.75, mode = "min" }, -- middle sun cascade at 3/4 resolution
	{ cmd = "r4_sun_smap_scale",    index = 3, value = 0.5,  mode = "min" }, -- far sun cascade at half resolution
}
local deck_preset_section = "deck_preset"

local function console_numbers(s)
	local t = {}
	for n in string.gmatch(s or "", "[-%d%.eE+]+") do
		t[#t + 1] = tonumber(n)
	end
	return t
end

local function deck_preset_value(e, current)
	if e.token then
		return e.token[current] or current
	end
	local nums = console_numbers(current)
	local i = e.index or 1
	if not nums[i] then
		return current
	end
	nums[i] = (e.mode == "max") and math.max(nums[i], e.value) or math.min(nums[i], e.value)
	if not e.index then
		return tostring(nums[1])
	end
	return table.concat(nums, ", ")
end

function apply_deck_preset()
	local enable = ui_options.get("video/advanced/deck_preset") == true
	local cfg = axr_main.config
	local con = get_console()

	if enable then
		-- Remember each setting once (a setting listed twice keeps its first, unchanged value)
		for _, e in ipairs(deck_preset) do
			if not cfg:r_value(deck_preset_section, e.cmd, 0) then
				local current = con:get_string(e.cmd)
				if current then
					cfg:w_value(deck_preset_section, e.cmd, current)
				end
			end
		end
		for _, e in ipairs(deck_preset) do
			local current = con:get_string(e.cmd)
			if current then
				exec_console_cmd(e.cmd .. " " .. deck_preset_value(e, current))
			end
		end
	else
		for _, e in ipairs(deck_preset) do
			local saved = cfg:r_value(deck_preset_section, e.cmd, 0)
			if saved then
				exec_console_cmd(e.cmd .. " " .. saved)
				cfg:w_value(deck_preset_section, e.cmd, nil)
			end
		end
	end

	cfg:save()
	exec_console_cmd("cfg_save")
end

-- UI entrypoint
function on_xml_read()
	ui_options_base = ui_options.init_opt_base
	ui_options.init_opt_base = function()
		ui_options_base()
		table.insert(ui_options.options, options_modded_exes.GROUP)

		function cont_sound_device()
			local cont = {}
			local devices = get_console():get_token_list("snd_device")
			if devices then
				for i=1,#devices do
					cont[#cont + 1] = {devices[i]}
				end
			end
			if #cont == 0 then
				local curr = get_console_cmd(0, "snd_device")
				cont[1] = {curr}
			end
			return cont
		end

		local v = ui_options.get_opt_table("sound/general/sound_device")
		if v then
			v.restart = false
			v.content = {cont_sound_device}
		end

		-- Extra options in vanilla options (not Modded Exes Options)
		local need_init_opt_coder = false

		-- Monitor selection
		function cont_vid_monitor()
			local cont = {}
			local monitors = get_console():get_token_list("vid_monitor")
			if monitors then
				for i=1,#monitors do
					cont[#cont + 1] = {monitors[i]}
				end
			end
			if #cont == 0 then
				local curr = get_console_cmd(0, "vid_monitor")
				cont[1] = {curr ~= "" and curr or "Auto"}
			end
			return cont
		end

		local basic = nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "basic" then basic = sub; break end
				end
				break
			end
		end
		if basic and basic.gr then
			local already_present = false
			local renderer_idx = nil
			for i, row in ipairs(basic.gr) do
				if row.id == "monitor" then
					already_present = true
					break
				end
				if row.id == "renderer" then
					renderer_idx = i
				end
			end
			if not already_present and renderer_idx then
				table.insert(basic.gr, renderer_idx + 1, {
					id      = "monitor",
					type    = "list",
					val     = 0,
					cmd     = "vid_monitor",
					content = {cont_vid_monitor},
					no_str  = true,
					restart = true,
				})
				need_init_opt_coder = true
			end
		end

		-- Persistent weather switch
		local weather = nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "weather" then weather = sub; break end
				end
				break
			end
		end
		if weather and weather.gr then
			local already_present = false
			local clear_slide = nil
			for i, row in ipairs(weather.gr) do
				if row.id == "persistent_weather" then
					already_present = true
					break
				end
				if row.id == "clear_slide" then
					clear_slide = i
				end
			end
			if not already_present and clear_slide then
				table.insert(weather.gr, clear_slide, {
					id      = "persistent_weather",
					type    = "check",
					val     = 1,
					def 	= true,
				})
				need_init_opt_coder = true
			end
		end

		-- Upscaler (DLSS / FSR, DX11 only), below SMAA in Video > Advanced
		local advanced = nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "advanced" then advanced = sub; break end
				end
				break
			end
		end
		if advanced and advanced.gr then
			local already_present = false
			local insert_idx = #advanced.gr + 1
			for i, row in ipairs(advanced.gr) do
				if row.id == "upscaler" then
					already_present = true
					break
				end
				if row.id == "smaa" then
					insert_idx = i + 1
				end
			end
			if not already_present then
				local for_r4 = {ui_options.for_renderer, "renderer_r4"}

				-- Only offer the upscalers this GPU supports ("dlss,fsr", "fsr" or "");
				-- nil when the engine doesn't report it (other renderers, older exes): offer both
				local avail = get_console():get_string("r4_upscaler_available")
				local upscaler_content = {{"off", "upscaler_off"}}
				if not avail or string.find(avail, "dlss", 1, true) then
					table.insert(upscaler_content, {"dlss", "upscaler_dlss"})
				end
				if not avail or string.find(avail, "fsr", 1, true) then
					table.insert(upscaler_content, {"fsr", "upscaler_fsr"})
				end
				local rows = {
					{
						id           = "upscaler",
						type         = "list",
						val          = 0,
						cmd          = "r4_upscaler",
						content      = upscaler_content,
						vid          = true,
						precondition = for_r4,
					},
					{
						id           = "upscaler_quality",
						type         = "list",
						val          = 0,
						cmd          = "r4_upscaler_quality",
						content      = {
							{"native", "upscaler_native"},
							{"quality", "upscaler_quality"},
							{"balanced", "upscaler_balanced"},
							{"performance", "upscaler_performance"},
							{"ultra_performance", "upscaler_ultra_performance"},
						},
						vid          = true,
						precondition = for_r4,
					},
					{
						id           = "fsr_sharpness",
						type         = "track",
						val          = 2,
						cmd          = "r4_fsr_sharpness",
						min          = 0,
						max          = 1,
						step         = 0.05,
						precondition = for_r4,
					},
					{
						id           = "perf_overlay",
						type         = "list",
						val          = 0,
						cmd          = "perf_overlay",
						content      = {{"off", "perf_overlay_off"}, {"compact", "perf_overlay_compact"}, {"detailed", "perf_overlay_detailed"}},
						precondition = for_r4,
					},
					{
						id           = "perf_overlay_pos",
						type         = "list",
						val          = 0,
						cmd          = "perf_overlay_pos",
						content      = {
							{"top_left", "perf_overlay_top_left"},
							{"top_right", "perf_overlay_top_right"},
							{"bottom_left", "perf_overlay_bottom_left"},
							{"bottom_right", "perf_overlay_bottom_right"},
						},
						precondition = for_r4,
					},
					{
						id           = "deck_preset",
						type         = "check",
						val          = 1,
						def          = false,
						functor      = {apply_deck_preset},
						vid          = true, -- shadow and screen space shadow quality need it
						precondition = for_r4,
					},
				}
				for i, row in ipairs(rows) do
					table.insert(advanced.gr, insert_idx + i - 1, row)
				end
				need_init_opt_coder = true
			end
		end

		if need_init_opt_coder and ui_options.init_opt_coder then
			ui_options.init_opt_coder()
		end
	end
	ui_options.init_opt_base()
end
