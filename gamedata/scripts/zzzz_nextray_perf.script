-- neXt-Ray performance patches for GAMMA's mods (in the engine's gamedata). The original mods stay untouched: this script
-- wraps their functions at runtime, and what they compute and show stays the same; only when the work runs changes.
-- A patch applies only to the mod's exact known version (the bytecode of the functions it relies on); after an update
-- of that mod it stays off (one log line with the new fingerprints) and the mod runs as it is.
--   nextray_perf_off: a file in appdata turns every patch off (for comparisons).
--
-- 1. Dynamic Anomalies (drx_da_main): every anomaly registers its own actor_on_update closure, which returns at once
--    unless the anomaly's own timer (binder.on_update_time) is due. Some 200 closures are called every frame only to
--    return. One dispatcher calls a closure only when its anomaly's timer is due; the closure checks it itself again.
--    The due time is kept next to the closure: only the anomaly's spawn and the closure itself write it (read back
--    after each call), and reading it from the binder every frame is what cost the time.
-- 2. Useful Idiots (illish.lib.surge): the emission cover cache, built on the first update of every load (about 1.6 s
--    of raycasts behind the loading screen), is built by the mod's own code spread over the first frames, ~2 ms each.
--    Anything that needs the cache sooner gets it finished on the spot; with an emission running it builds at once.
-- 3. 3DSS (z_3dss_shader_switcher): while a save loads, the inventory is put back slot by slot and every slot change
--    normalizes the new weapon's scope marker shaders (about 25 ms each, 20 to 60 times per load, mostly the same few
--    weapons, one per frame). While the load runs the requests are only noted; at the end of the load, before the
--    first frame is shown (on_loading_screen_key_prompt), each weapon is normalized once by the mod's own function.
--    After that every call goes straight to the mod.

local log_prefix = "* [neXt-Ray perf] "

local function msg(fmt, ...)
	log(log_prefix .. string.format(fmt, ...))
end

-- A function's bytecode without debug info, hashed (as _g_patches.script): the same for the same code
local function fingerprint(f)
	if type(f) ~= "function" then return "none" end
	local ok, d = pcall(string.dump, f, true)
	if not ok then return "?" end
	local h = 0
	for i = 1, #d do h = (h * 31 + d:byte(i)) % 2147483647 end
	return #d .. ":" .. h
end

-- The known versions (GAMMA, 2026-10)
local KNOWN = {
	da_update = "938:774180173", -- drx_da_main: the anomaly's actor_on_update closure (returns until binder.on_update_time)
	surge_build = "766:1699894902", surge_nearby = "445:1118901213", -- illish.lib.surge buildCovers, nearbyCovers
	pos_snap = "74:1471059612", -- illish.lib.pos snap
	tdss_normalize = "262:1173514111", -- z_3dss_shader_switcher.normalize_marker_shaders
}

---------------------------------------------------------------------------------------------------------------------
-- 1. Dynamic Anomalies: one dispatcher for the anomalies' timed update closures

local da_sched = {} -- update key -> { binder = anomaly binder, func = the mod's closure }
local da_count = 0
local da_known = nil -- the closures are the known code: checked on the first one

local function da_patch()
	if not (drx_da_main and type(drx_da_main.callbacks) == "table") then return false end
	local abf = bind_anomaly_field and bind_anomaly_field.anomaly_field_binder
	if not (abf and abf.net_spawn and abf.net_destroy) then return false end

	local spawn = abf.net_spawn
	abf.net_spawn = function(self, se_abstract)
		local result = spawn(self, se_abstract)
		local key = self.update_key
		local cb = key and drx_da_main.callbacks[key]
		if da_known == nil and cb and type(cb.func) == "function" then
			local fp = fingerprint(cb.func)
			da_known = fp == KNOWN.da_update
			if not da_known then
				msg("Dynamic Anomalies' update closure is not the known one (%s), kept", fp)
			end
		end
		if da_known and cb and cb.callback == "actor_on_update" and type(cb.func) == "function" and type(self.on_update_time) == "number" then
			UnregisterScriptCallback("actor_on_update", cb.func)
			if not da_sched[key] then da_count = da_count + 1 end
			da_sched[key] = { binder = self, func = cb.func, due = self.on_update_time }
		end
		return result
	end

	local destroy = abf.net_destroy
	abf.net_destroy = function(self)
		local key = self.update_key
		if key and da_sched[key] then
			da_sched[key] = nil
			da_count = da_count - 1
		end
		return destroy(self)
	end
	return true
end

local function da_update()
	local tg = time_global()
	local callbacks = drx_da_main.callbacks
	for key, e in pairs(da_sched) do
		if tg >= e.due then
			local cb = callbacks[key]
			if not cb or cb.func ~= e.func then
				-- The mod removed or registered the closure again: from now on it is the mod's own registration
				da_sched[key] = nil
				da_count = da_count - 1
			else
				e.func()
				e.due = e.binder.on_update_time or tg
			end
		end
	end
end

---------------------------------------------------------------------------------------------------------------------
-- 2. Useful Idiots: the emission cover cache built over the first frames

local surge_co = nil          -- the mod's buildCovers running as a coroutine
local surge_timer = nil       -- time spent in it this frame
local surge_budget_us = 2000
local surge_load_window = true -- until the first actor_on_update: the call from the first update
local surge_frames = 0
local surge_snaps, surge_yields, surge_us = 0, 0, 0

local function surge_finish()
	local co = surge_co
	surge_timer = nil -- no yields from here on
	while co and coroutine.status(co) ~= "dead" do
		local okc, err = coroutine.resume(co)
		if not okc then
			msg("cover cache build failed: %s", tostring(err))
			break
		end
	end
	surge_co = nil
end

local function surge_active()
	local s = surge_manager and surge_manager.is_started and surge_manager.is_started()
	local p = psi_storm_manager and psi_storm_manager.is_started and psi_storm_manager.is_started()
	return s or p
end

local function surge_patch()
	local ok, SURGE = pcall(require, "illish.lib.surge")
	if not (ok and type(SURGE) == "table" and type(SURGE.buildCovers) == "function") then return false end
	local okp, POS = pcall(require, "illish.lib.pos")
	if not (okp and type(POS) == "table" and type(POS.snap) == "function") then return false end
	local fb, fn, fs = fingerprint(SURGE.buildCovers), fingerprint(SURGE.nearbyCovers), fingerprint(POS.snap)
	if fb ~= KNOWN.surge_build or fn ~= KNOWN.surge_nearby or fs ~= KNOWN.pos_snap then
		msg("Useful Idiots' cover cache functions are not the known ones (%s %s %s), kept", fb, fn, fs)
		return false
	end

	local build = SURGE.buildCovers
	local snap = POS.snap

	-- nearbyCovers snaps each sample point to the AI grid, then tests it for cover: the step to yield between
	POS.snap = function(...)
		if surge_co and surge_timer and coroutine.running() == surge_co then
			surge_snaps = surge_snaps + 1
			surge_timer:stop()
			if surge_timer:time() >= surge_budget_us then
				surge_yields = surge_yields + 1
				coroutine.yield()
				-- resumed in a later frame: surge_update started that frame's timer already
			else
				surge_timer:start()
			end
		end
		return snap(...)
	end

	SURGE.buildCovers = function(force)
		if surge_co then
			if force then
				surge_co = nil -- abandoned: the forced build starts over below
			else
				surge_finish()
			end
		elseif surge_load_window and not force and not surge_active() then
			surge_load_window = false
			surge_frames = 0
			surge_co = coroutine.create(function() build() end)
			return {}, {} -- the first update ignores the result
		end
		return build(force)
	end
	return true
end

local function surge_update()
	surge_load_window = false
	if not surge_co then return end
	if surge_active() then
		-- An emission started while the cache was still building: finish it now, as the mod would have had it
		surge_finish()
		msg("emission started: cover cache finished at once")
		return
	end
	surge_timer = profile_timer()
	surge_timer:start()
	local frame_timer = profile_timer()
	frame_timer:start()
	local okc, err = coroutine.resume(surge_co)
	frame_timer:stop()
	surge_us = surge_us + frame_timer:time()
	surge_frames = surge_frames + 1
	if not okc then
		msg("cover cache build failed: %s", tostring(err))
		surge_co = nil
	elseif coroutine.status(surge_co) == "dead" then
		msg("emission cover cache built over %d frames, %.0f ms in all, %d grid snaps, %d yields", surge_frames, surge_us / 1000, surge_snaps, surge_yields)
		surge_co = nil
	end
	surge_timer = nil
end

---------------------------------------------------------------------------------------------------------------------
-- 3. 3DSS: marker shader normalization once per weapon after a load

local tdss_loading = true -- from the script load (the start of a load) to the end of the load
local tdss_pending = {} -- weapon id -> true
local tdss_calls, tdss_done = 0, 0
local tdss_deadline = nil -- fallback when the end of the load isn't signalled: 10 s after the first update

local function tdss_patch()
	local m = z_3dss_shader_switcher
	if not (m and type(m.normalize_marker_shaders) == "function") then return false end
	local fp = fingerprint(m.normalize_marker_shaders)
	if fp ~= KNOWN.tdss_normalize then
		msg("3DSS's normalize_marker_shaders is not the known one (%s), kept", fp)
		return false
	end
	local normalize = m.normalize_marker_shaders
	m.normalize_marker_shaders = function(weapon)
		if tdss_loading and weapon and weapon.id then
			tdss_pending[weapon:id()] = true
			tdss_calls = tdss_calls + 1
			return
		end
		return normalize(weapon)
	end
	m.nextray_normalize = normalize
	return true
end

local function tdss_flush()
	if not tdss_loading then return end
	tdss_loading = false
	local pending = tdss_pending
	tdss_pending = {}
	local normalize = z_3dss_shader_switcher.nextray_normalize
	for id in pairs(pending) do
		local obj = level.object_by_id(id)
		if obj then
			normalize(obj)
			tdss_done = tdss_done + 1
		end
	end
end

---------------------------------------------------------------------------------------------------------------------

local da_on, surge_on, tdss_on = false, false, false
local reported = false
local reported_after = 0

local function actor_on_update()
	if tdss_loading and tdss_deadline and time_global() > tdss_deadline then tdss_flush() end
	if da_on then da_update() end
	if surge_on then surge_update() end
	if not reported and time_global() > reported_after then
		reported = true
		if tdss_calls > 0 then
			msg("3DSS: %d marker normalization requests done as %d", tdss_calls, tdss_done)
		end
		msg("Dynamic Anomalies dispatcher %s (%d anomalies), emission cover cache %s, 3DSS normalization after loads %s",
			da_on and da_known and "on" or "off", da_count, surge_on and "spread over frames" or "off", tdss_on and "on" or "off")
	end
end

function on_game_start()
	local f = getFS()
	local off = io.open(f:update_path("$app_data_root$", "nextray_perf_off"), "r")
	if off then
		off:close()
		msg("off (appdata\\nextray_perf_off)")
		return
	end
	da_on = da_patch()
	surge_on = surge_patch()
	tdss_on = tdss_patch()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_first_update", function()
		reported_after = time_global() + 5000
		tdss_deadline = time_global() + 10000
	end)
	if tdss_on then
		RegisterScriptCallback("on_loading_screen_key_prompt", tdss_flush)
	end
end

---------------------------------------------------------------------------------------------------------------------
-- Measuring aid (the console lowercases its commands): run_string zzzz_nextray_perf.bench()
function bench()
	local function B(n, f, k)
		k = k or 100
		if type(f) ~= "function" then
			log(string.format("~bench %-28s n/a", n))
			return
		end
		local t = profile_timer()
		t:start()
		for i = 1, k do f() end
		t:stop()
		log(string.format("~bench %-28s %9.1f us", n, t:time() / k))
	end
	local lg = demonized_ledge_grabbing
	B("ledge.checkLedgeGrabbing", lg and lg.checkLedgeGrabbing)
	B("ledge.checkClimbPrecondition", lg and lg.checkClimbPrecondition)
	B("ledge.getActorWeights", lg and lg.getActorWeights)
	B("ledge.getActorMaxWalkWeight", lg and lg.getActorMaxWalkWeight)
	B("IsMoveState(mcClimb)", function() return IsMoveState("mcClimb") end)
	B("actor:get_total_weight", function() return db.actor:get_total_weight() end)
	B("actor:iterate_belt", function() db.actor:iterate_belt(function() end) end)
	local okS, S = pcall(require, "illish.lib.surge")
	B("surge.buildCovers(true)", okS and S and function() S.buildCovers(true) end, 1)
end
