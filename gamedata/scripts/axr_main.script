-- Kutez: Callback Priority System (https://github.com/themrdemonized/xray-monolith/pull/339)
local next_index = {}
for name,v in pairs(intercepts) do
	next_index[name] = 1
end

-----------------------------------------------------------
-- Global Callback Register
-- param 1 - name as type<string> (ie. intercepts[name])
-- param 2 - function to execute as type<function> or userdata with name as function
-----------------------------------------------------------
-- Each callback's functions in call order, kept until a function is set or unset: make_callback sorted them
-- on every call. callback_order_cache = false sorts on every call again (for comparing).
callback_order_cache = true
local callback_order = {}

local function ordered_callbacks(name)
	local list = callback_order_cache and callback_order[name]
	if not list then
		list = {}
		for func_or_userdata in spairs(intercepts[name], sort_func_values_ascend) do
			list[#list + 1] = func_or_userdata
		end
		callback_order[name] = list
	end
	return list
end

function callback_add(name)
	callback_order[name] = nil
	if (not intercepts[name]) then
		intercepts[name] = {}
		next_index[name] = 1
	else
		printf("![axr_main callback_add] callback %s already exists!",name)
		callstack()
	end
end

function callback_set(name,func_or_userdata)
	if (func_or_userdata == nil) then 
		printf("![axr_main callback_set] trying to set callback %s to nil function!",name)
		callstack()
		return
	end
	callback_order[name] = nil
	if (intercepts[name]) then
		intercepts[name][func_or_userdata] = next_index[name]
		next_index[name] = next_index[name] + 1
	else
		printf("![axr_main callback_set] callback %s doesn't exist!",name)
		callstack()
	end
end

function callback_unset(name,func_or_userdata)
	callback_order[name] = nil
	if (intercepts[name]) then
		intercepts[name][func_or_userdata] = nil
	else
		printf("![axr_main callback_unset] callback %s doesn't exist!",name)
		callstack()
	end
end

-----------------------------------------------------------
-- Callback profiler: lua_profile_start(seconds), e.g. "run_string axr_main.lua_profile_start(5)" (needs -dbg).
-- Times every function make_callback calls, per callback and per function (script file and line), and the
-- dispatch around them, then writes the per frame averages to the log. Off, it costs one check per callback.
-----------------------------------------------------------
local prof = nil

local function prof_timer(tbl, key)
	local t = tbl[key]
	if not t then
		t = { timer = profile_timer(), calls = 0 }
		tbl[key] = t
	end
	t.calls = t.calls + 1
	return t.timer
end

local function prof_key(P, name, f)
	local key = P.keys[f]
	if not key then
		local info = debug and debug.getinfo and debug.getinfo(f, "S")
		key = name .. "  " .. (info and (tostring(info.short_src) .. ":" .. tostring(info.linedefined)) or tostring(f))
		P.keys[f] = key
	end
	return key
end

local function prof_report()
	local frames = math.max(1, device().frame - prof.start_frame)
	local function sorted(tbl)
		local list = {}
		for key, t in pairs(tbl) do
			list[#list + 1] = { key = key, us = t.timer:time(), calls = t.calls }
		end
		table.sort(list, function(a, b) return a.us > b.us end)
		return list
	end
	log(string.format("* [Lua callbacks] average per frame over %d frames (ms incl. nested callbacks, calls)", frames))
	-- Time in the callbacks' functions, per callback: the rest of a callback's time is its dispatch
	local in_funcs = {}
	for key, t in pairs(prof.funcs) do
		local name = string.match(key, "^(%S+)")
		in_funcs[name] = (in_funcs[name] or 0) + t.timer:time()
	end
	log(string.format("*   by callback: total, calls, of it dispatch (sorting, calls)"))
	for i, e in ipairs(sorted(prof.totals)) do
		if i > 25 then break end
		log(string.format("*     %-60s %7.3f %7.1f %7.3f", e.key, e.us / 1000 / frames, e.calls / frames, (e.us - (in_funcs[e.key] or 0)) / 1000 / frames))
	end
	log(string.format("*   by function:"))
	for i, e in ipairs(sorted(prof.funcs)) do
		if i > 60 or e.us / 1000 / frames < 0.01 then break end
		log(string.format("*     %-60s %7.3f %7.1f", e.key, e.us / 1000 / frames, e.calls / frames))
	end
	prof = nil
	get_console():execute("flush")
end

function lua_profile_start(seconds)
	prof = { totals = {}, funcs = {}, keys = {}, start_frame = device().frame, end_time = time_global() + (seconds or 5) * 1000 }
	log(string.format("* [Lua callbacks] measuring for %d s...", seconds or 5))
end

local function make_callback_profiled(name, ...)
	-- This capture's tables, also when a nested callback ends it
	local P = prof
	local total = prof_timer(P.totals, name)
	total:start()
	local list = ordered_callbacks(name)
	for i = 1, #list do
		local func_or_userdata = list[i]
		local f = func_or_userdata
		if (type(func_or_userdata) ~= "function") then
			f = func_or_userdata[name]
		end
		if f then
			local t = prof_timer(P.funcs, prof_key(P, name, f))
			t:start()
			if (f == func_or_userdata) then
				f(...)
			else
				f(func_or_userdata, ...)
			end
			t:stop()
		end
	end
	total:stop()
	if (prof and time_global() >= prof.end_time) then
		prof_report()
	end
end

function make_callback(name,...)
	if (prof and intercepts[name]) then
		return make_callback_profiled(name, ...)
	end
	if (intercepts[name]) then
		-- The list, not the table: a function set or unset meanwhile doesn't change this call's list (as spairs)
		local list = ordered_callbacks(name)
		for i = 1, #list do
			local func_or_userdata = list[i]
			if (type(func_or_userdata) == "function") then 
				func_or_userdata(...)
			elseif (func_or_userdata[name]) then
				func_or_userdata[name](func_or_userdata,...)
			end
		end
	else
		printf("![axr_main make_callback] can't make callback to non existing intercept %s!",name)
		callstack()
	end
end

--------------------------------------------------------------------------------------------------------------------
-- ON GAME START
--------------------------------------------------------------------------------------------------------------------
function on_game_start()
	local ignore = { 
		["_G.script"] = true,
		["class_registrator.script"] = true,
		["game_registrator.script"] = true,
		["ui_registrator.script"] = true,
		["ce_new_attachable_item.script"] = true,
		["ce_new_game_dm.script"] = true,
		["sim_faction_brain_human.script"] = true,
		["sim_faction_brain_mutant.script"] = true,
		["ce_switcher.script"] = true,
		["axr_main.script"] = true,
		["lua_help.script"] = true,
		["rx_gl.script"] = true
	}
	
	local t = {}
	local size_t = 0 
	local f	= getFS()
	local flist = f:file_list_open_ex("$game_scripts$",bit_or(FS.FS_ListFiles,FS.FS_RootOnly),"*.script")
	local f_cnt = flist:Size()
	-- Load time on every level load (it runs all scripts again): loading them, then each one's on_game_start
	local load_timer = profile_timer()
	load_timer:start()
	-- With the file appdata\lua_load_profile present: where loading the scripts spends its time, by source line
	-- and function (sampled every 1000 Lua instructions, the time since the last sample counted for the current place)
	local sampler = nil
	if (f:exist("$app_data_root$", "lua_load_profile") and debug and debug.sethook) then
		sampler = { lines = {}, funcs = {}, clock = profile_timer(), last = 0 }
		sampler.clock:start()
		debug.sethook(function()
			sampler.clock:stop()
			local now = sampler.clock:time()
			sampler.clock:start()
			local dt = now - sampler.last
			sampler.last = now
			local info = debug.getinfo(2, "Sln")
			if info then
				local line = info.short_src .. ":" .. tostring(info.currentline)
				local func = info.short_src .. ":" .. tostring(info.linedefined) .. " " .. tostring(info.name)
				sampler.lines[line] = (sampler.lines[line] or 0) + dt
				sampler.funcs[func] = (sampler.funcs[func] or 0) + dt
			end
		end, "", 1000)
	end
	for	it=0, f_cnt-1 do
		local file = flist:GetAt(it)
		local file_name = file:NameShort()
		--printf("%s size=%s",file_name,file:Size())
		if (file:Size() > 0 and ignore[file_name] ~= true) then
			file_name = file_name:sub(0,file_name:len()-7)
			if (_G[file_name] and _G[file_name].on_game_start) then
				size_t = size_t + 1 
				t[size_t] = file_name -- load all scripts first
			end
		end
	end
	load_timer:stop()
	if sampler then
		debug.sethook()
		local function top(tbl, title)
			local list = {}
			for k, v in pairs(tbl) do list[#list + 1] = { k = k, v = v } end
			table.sort(list, function(a, b) return a.v > b.v end)
			log(string.format("* [axr_main] load profile, %s:", title))
			for i = 1, math.min(30, #list) do
				log(string.format("*   %8.1f ms  %s", list[i].v / 1000, list[i].k))
			end
		end
		top(sampler.funcs, "by function")
		top(sampler.lines, "by line")
	end
	local start_timers = {}
	local start_total = profile_timer()
	start_total:start()
	for i=1,#t do
		--printf("%s.on_game_start()",t[i])
		local timer = profile_timer()
		timer:start()
		_G[ t[i] ].on_game_start()
		timer:stop()
		start_timers[#start_timers + 1] = { name = t[i], us = timer:time() }
	end
	start_total:stop()
	table.sort(start_timers, function(a, b) return a.us > b.us end)
	local top = {}
	for i = 1, math.min(8, #start_timers) do
		top[#top + 1] = string.format("%s %.0f", start_timers[i].name, start_timers[i].us / 1000)
	end
	log(string.format("* [axr_main] scripts loaded in %.0f ms, %d on_game_start in %.0f ms, slowest (ms): %s",
		load_timer:time() / 1000, #t, start_total:time() / 1000, table.concat(top, ", ")))
end

------------------
-- main_menu_on_init()
------------------
function main_menu_on_init(menu)
	xrs_dyn_music.main_menu_on(menu)
end

------------------
-- main_menu_on_quit()
------------------
function main_menu_on_quit(menu)
	xrs_dyn_music.main_menu_off(menu)
end

function actor_on_weapon_zoom_in()
	local wpn = db.actor:active_item()
	
	scoped_weapon_is_zoomed = wpn and IsWeapon(wpn) and wpn:weapon_is_scope()
	binoc_is_zoomed = wpn and (wpn:section() == "wpn_binoc_inv")
	weapon_is_zoomed = true
	
	SendScriptCallback("GUI_on_show", "UIZoom") -- to force hiding HUD UIs on Zooming
end 

function actor_on_weapon_zoom_out()
	scoped_weapon_is_zoomed = false
	binoc_is_zoomed = false
	weapon_is_zoomed = false
	SendScriptCallback("GUI_on_hide", "UIZoom") -- to force hiding HUD UIs on Zooming
end

------------------
-- server_entity_on_register
------------------
function server_entity_on_register(se_obj,type_name)
	local id = se_obj.id
	if (id == AC_ID) then
		story_objects.register(id,"actor")
	else
		story_objects.check_spawn_ini_for_story_id(se_obj)
	end
end

------------------
-- server_entity_on_unregister
------------------
-- good place to remove ids from persistent tables
function server_entity_on_unregister(se_obj,type_name)
	local id = se_obj.id
	local m_data = alife_storage_manager.get_state()
	if (m_data) then 
		if (m_data.se_object) then
			m_data.se_object[id] = nil
			--printf("$ alife_storage | cleaning server object [%s](%s) mdata", se_obj:name(), id)
		end
		if (m_data.game_object) then
			m_data.game_object[id] = nil
			--printf("$ alife_storage | cleaning game object [%s](%s) mdata", se_obj:name(), id)
		end
	end
	story_objects.unregister(id)
end