// neXt-Ray shader patch of Screen Space Shaders 23's r3\ssfx_ssr_gloss.ps: CRC32 ae59e5e9, group ssr
// neXt-Ray: SSR gloss: the sky reflection's two cube map taps (mip 0 of the weather's sky, the
// pass' main cost) only where the SSR pass uses them. Bit 0x800 of r4_shader_patches (NEXTRAY_PATCHES) picks the changed
// code, kept next to the original; engines without the define use it
#ifndef NEXTRAY_PATCHES
#define NEXTRAY_PATCHES 0xFFF
#endif
#if (NEXTRAY_PATCHES & 0x400)
// neXt-Ray (bit 0x400): with the engine's sky binding for the SSR pass, ssfx_ssr.ps takes the sky itself where it shows
uniform float4 nextray_ssr_sky;
#endif
#if (NEXTRAY_PATCHES & 0x800) || (NEXTRAY_PATCHES & 0x400)
// neXt-Ray: ssfx_ssr.ps multiplies its result by saturate(gloss.a * 10) and marches only where gloss.a > 0.02; off
// terrain, an unmarched pixel's reflection is the sky times 0. So the sky (rgb) is not used where the stored alpha
// (8 bit) is 0, or is 1..5 (5/255 <= 0.02) off terrain. The SSR pass reads this target at its texel centers only at
// full resolution (ssr_setup.x == 1, set by the engine for this pass), elsewhere the sky is always written
uniform float4 ssr_setup;
#endif
/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 21
 * @ Description: SSR - Gloss Phase
 * @ Modified time: 2025-02-08 15:59
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 */

#include "screenspace_common.h"
#include "settings_screenspace_SSR.h"

uniform float4 ssfx_ssr_2;
uniform float4 ssfx_is_underground;

Texture2D s_motion_vectors;

float4 main(p_screen I) : SV_Target
{

#ifndef USE_MSAA
	float4 Pos = s_position.Sample( smp_nofilter, I.tc0 );
	float gloss = s_diffuse.Sample( smp_nofilter, I.tc0 ).a;
#else
	float4 Pos = s_position.Load( int3( I.hpos.xy, 0 ), 0 );
	float gloss = s_diffuse.Load( int3( I.hpos.xy, 0 ), 0 ).a;
#endif

	float3 P 	= float3( Pos.z * ( I.hpos * pos_decompression_params.zw - pos_decompression_params.xy ), Pos.z );
	float3 N 	= gbuf_unpack_normal( Pos.xy );
	float mtl	= gbuf_unpack_mtl( Pos.w );

	// [ xy = MV | z = HUD Mask ]
	float3 Motion_Vectors = s_motion_vectors.Sample(smp_nofilter, I.tc0);

	float HUD_mask = 1.0f - Motion_Vectors.b;

	bool m_flora = abs(mtl - MAT_FLORA) <= 0.04f;

	// Calc reflection bounce
	float3 inVec = normalize(P.xyz); // Incident
	float3 reVec = reflect(inVec , N); // Reflected

	// Transform space and calc reflection vector ( Skybox & Fresnel )
	float3 nw		 = mul(m_inv_V, N);
	float3 v2point	 = mul(m_inv_V, inVec);
	float3 v2reflect = reflect(v2point, nw);

	// Fresnel
	float fresnel = saturate (dot(v2reflect, v2point));
	float fresnel_amount = pow(fresnel, 3);
	gloss *= fresnel_amount;

#if !(NEXTRAY_PATCHES & 0x800) && !(NEXTRAY_PATCHES & 0x400)
#ifdef G_SSR_CHEAP_SKYBOX
	float3 sky = SSFX_calc_env(v2reflect) * ssfx_ssr_2.y * !ssfx_is_underground.x;
#else
	float3 sky = SSFX_calc_sky(v2reflect) * ssfx_ssr_2.y * !ssfx_is_underground.x;
#endif
#endif

	// Flora intensity
	gloss *= m_flora ? G_SSR_FLORA_INTENSITY : 1.0f;

	// Global intensity and limit max value.
	float main_clamp = clamp(gloss * ssfx_ssr_2.x, 0, G_SSR_MAX_INTENSITY);
	
	// Raise reflection intensity and max limit when raining. ( NOTE: Reverted to rain intensity, but improvements are on the way... )
	float rain_extra = G_SSR_WEAPON_RAIN_FACTOR * rain_params.x;

	// Weapon intensity and limit max value.
	float wpn_clamp = clamp(gloss * ssfx_ssr_2.z, 0, ssfx_ssr_2.w + rain_extra);

	#ifdef G_SSR_WEAPON_REFLECT_ONLY_WITH_RAIN
		wpn_clamp *= rain_params.x;
	#endif

	// Lerp between general reflections and weapon reflections.
	gloss = lerp(wpn_clamp, main_clamp, HUD_mask);

	// Fog
	float fog = 1.0 - saturate(( length(P.xyz) * fog_params.w + fog_params.x));

	// Sky discard
	if (P.z < SKY_EPS)
	{
#if !(NEXTRAY_PATCHES & 0x800) && !(NEXTRAY_PATCHES & 0x400)
		sky *= 0;
#endif
		gloss *= 0;
	}

#if !(NEXTRAY_PATCHES & 0x800) && !(NEXTRAY_PATCHES & 0x400)
	// Mix
	return float4(sky, gloss * fog * fog);
#else
	const float alpha = gloss * fog * fog;
	const bool m_terrain = abs(mtl - 0.95f) <= 0.02f; // as ssfx_ssr.ps (screenspace_reflections.h) tests it
	[branch]
#if (NEXTRAY_PATCHES & 0x400)
	if (ssr_setup.x == 1.0f && nextray_ssr_sky.x == 1.0f)
		return float4(0, 0, 0, alpha);
#endif
#if (NEXTRAY_PATCHES & 0x800)
	if (ssr_setup.x == 1.0f && (alpha * 255.0f < 0.49f || (alpha * 255.0f < 5.49f && !m_terrain)))
		return float4(0, 0, 0, alpha);
#endif

#ifdef G_SSR_CHEAP_SKYBOX
	float3 sky = SSFX_calc_env(v2reflect) * ssfx_ssr_2.y * !ssfx_is_underground.x;
#else
	float3 sky = SSFX_calc_sky(v2reflect) * ssfx_ssr_2.y * !ssfx_is_underground.x;
#endif
	if (P.z < SKY_EPS)
		sky *= 0;

	// Mix
	return float4(sky, alpha);
#endif
}