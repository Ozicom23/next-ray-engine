// neXt-Ray shader patch of Screen Space Shaders 23's r3\ssfx_ssr.ps: CRC32 08e1daab, group ssr
// neXt-Ray: SSR: the sky reflection (two cube map taps at mip 0) taken here, only where it shows,
// instead of for every reflective pixel in the gloss pass (ssfx_ssr_gloss.ps). Bit 0x400 of r4_shader_patches
// (NEXTRAY_PATCHES) picks the changed code, kept next to the original; engines without the define use it. Only with the
// engine's sky bindings for this pass (nextray_ssr_sky.x == 1) and at full SSR resolution (ssr_setup.x == 1)
#ifndef NEXTRAY_PATCHES
#define NEXTRAY_PATCHES 0xFFF
#endif
/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 21
 * @ Description: SSR
 * @ Modified time: 2025-02-09 00:25
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 */

//uniform float4 shader_param_7;

#include "screenspace_reflections.h"

#if (NEXTRAY_PATCHES & 0x400)
uniform float4 nextray_ssr_sky; // x: 1 when the engine binds the sky for this pass

// The gloss pass' sky, as it stores it (8 bit unorm target)
float3 NXR_ssr_sky(float3 P, float3 N)
{
	float3 inVec = normalize(P.xyz);
	float3 nw		 = mul(m_inv_V, N);
	float3 v2point	 = mul(m_inv_V, inVec);
	float3 v2reflect = reflect(v2point, nw);
#ifdef G_SSR_CHEAP_SKYBOX
	float3 sky = SSFX_calc_env(v2reflect) * ssfx_ssr_2.y * !ssfx_is_underground.x;
#else
	float3 sky = SSFX_calc_sky(v2reflect) * ssfx_ssr_2.y * !ssfx_is_underground.x;
#endif
	return round(saturate(sky) * 255.0f) / 255.0f;
}

// SSFX_ScreenSpaceReflections (screenspace_reflections.h) with gloss.rgb (the sky) taken only where the result uses it:
// off terrain a hit gives lerp(0, scene, fade), on terrain a full fade gives the scene; without a hit the sky is scaled
// by the ray's fade (0 off terrain without sky along the ray)
// lazy: the gloss pass left the sky out (else gloss.rgb is used as in the original). Called without flow control
// around it: the march takes implicit gradients (blue noise)
void NXR_ScreenSpaceReflections(float2 tc, float4 P, float3 N, float4 gloss, inout float4 color, float HudMask, inout float2 noise, inout float hitdepth, bool lazy, uint iSample : SV_SAMPLEINDEX)
{
	bool m_terrain = abs(P.w - 0.95f) <= 0.02f;

	float3 inVec = normalize(P.xyz); // Incident
	float3 reVec = reflect(inVec , N); // Reflected

	float4 hit_uv = 0;

	if (gloss.w > 0.02f)
		hit_uv = SSFX_ssr_fast_ray(P.xyz, reVec, tc, HudMask, noise, iSample);

	float3 reflection = lazy ? 0 : gloss.rgb;

	if (all(hit_uv.xy))
	{
		float3 scene = SSFX_get_image(hit_uv.xy, iSample);
		float HitFade = saturate(hit_uv.y * G_SSR_VERTICAL_SCREENFADE);
		[branch]
		if (lazy && m_terrain && HitFade < 1.0f)
			reflection = NXR_ssr_sky(P.xyz, N);
		reflection.rgb = lerp(reflection * m_terrain, scene, HitFade);
	}
	else
	{
		float ray_fade = saturate(saturate(hit_uv.w * G_SSR_VERTICAL_SCREENFADE) + m_terrain);
		[branch]
		if (lazy && ray_fade > 0.0f)
			reflection = NXR_ssr_sky(P.xyz, N);
		reflection *= ray_fade;
	}

	color.rgb = reflection;

	hitdepth = hit_uv.z;
}
#endif

float4x4 m_current; // Current projection matrix
float4x4 m_previous; // Previous projection matrix
float4 cam_pos;

Texture2D ssr_image;
Texture2D s_prev_pos;
Texture2D s_gloss_data;
Texture2D s_motion_vectors;

float4 main(p_screen I) : SV_Target
{
// Sample buffers and prepare all requiered data ------------------
	
	// Scale TexCoor
	float2 tc = I.tc0 * ssr_setup.x;
	float2 Pos2D = I.hpos * ssr_setup.x;


	// Sample buffers
#ifndef USE_MSAA
	float4 Pos = s_position.Sample( smp_nofilter, tc );
#else
	float4 Pos = s_position.Load( int3( Pos2D, 0 ), 0 );
#endif

	// [ xy = MV | z = HUD Mask ]
	float3 Motion_Vectors = s_motion_vectors.Sample(smp_nofilter, tc);

	float4 GlossData = s_gloss_data.Sample( smp_linear, tc );
	float HUD_mask = 1.0 - Motion_Vectors.z;

	// Reconstruct Position, Normal and Material
	float3 P 	= float3( Pos.z * ( Pos2D * pos_decompression_params.zw - pos_decompression_params.xy ), Pos.z );
	float3 N 	= gbuf_unpack_normal( Pos.xy );
	float mtl	= gbuf_unpack_mtl( Pos.w );

// SSR ------------------------------------------------------------
	float4 ssr_result = 0;
	float2 noise = 0;

	float HitDepth = 0;

	// Do the SSR
#if !(NEXTRAY_PATCHES & 0x400)
	SSFX_ScreenSpaceReflections(tc, float4(P, mtl), N, GlossData, ssr_result, HUD_mask, noise, HitDepth, 0);
#else
	const bool lazy = nextray_ssr_sky.x == 1.0f && ssr_setup.x == 1.0f && GlossData.a > 0.0f;
	NXR_ScreenSpaceReflections(tc, float4(P, mtl), N, GlossData, ssr_result, HUD_mask, noise, HitDepth, lazy, 0);
#endif
	
// Accumulation ---------------------------------------------------

	// Position
	//float4 P4 = float4(P, 1.0);

	// Reconstruction of ray hit position
	float3 Hit_Pv = float3(HitDepth * (Pos2D * pos_decompression_params.zw - pos_decompression_params.xy), HitDepth);
	
	// Position
	float4 P4 = float4(Hit_Pv.xyz, 1.0);

	// Sky Bounce
	if (HitDepth <= SKY_EPS)
		P4.xyz = float3(P.xy, 100000);


	
	// Get current
	float4 p_current = mul(m_current, P4);
	
	// Get previous
	float4 p_previous = mul(m_previous, P4);

	float3 current = p_current.xyz / p_current.w;
	float3 previous = p_previous.xyz / p_previous.w;

	// Reprojection UV
	float2 uv_rp = float2(current.x - previous.x, current.y - previous.y);
	uv_rp = float2(uv_rp.x, -uv_rp.y) * 0.5f;
	
	uv_rp = lerp(Motion_Vectors.xy, uv_rp, HUD_mask);

	// Prev Position + Reprojection UV
	float4 prev_P = s_prev_pos.Sample( smp_linear, (tc - uv_rp) );

	uv_rp /= ssr_setup.x;

	// Disocclusion
	float docc = abs(1.0f - P.z / prev_P.z) * 5.0f;

	//float vel = saturate(distance(current.xy, previous.xy) * 10.0f);

	// Offscreen check	
	int outoffsrc = any((I.tc0 - uv_rp) < 0) + any((I.tc0 - uv_rp) > (1.0 / ssr_setup.x));

	/*float2 rnd = hash22(I.tc0 * 100 + timers.xx * 100) * 2.0f - 1.0f;
	rnd = rnd * (1.0f / screen_res.xy) * 0.25f;*/

	// Previous frame + Reprojection UV
	float4 prev = ssr_image.Sample(smp_linear, I.tc0 - uv_rp);
	//float4 prev = ssr_image.Sample(smp_linear, (I.tc0 + rnd) - uv_rp);

	// Sky weight
	float sky_weight = HitDepth <= SKY_EPS ? 0.2f : 0.0;

	// 0 Current frame ~ 1 Prev frame 1 - 2 - 4 
	//float weight = saturate((0.5f + (ssr_setup.x * 0.1f * HUD_mask)) - (outoffsrc + docc)); // + vel
	float weight = saturate(0.8f - (outoffsrc + docc + sky_weight)); // + vel

	// Apply gloss intensity data to avoid leaking
	ssr_result.rgb *= saturate(GlossData.a * 10.0f); // 0.1f == 1.0f

// ----------------------------------------------------------------

	// Mix with previous SSR results. Higher weight more of the previous frame used
	return float4(lerp(ssr_result.rgb, prev.rgb, weight ), 1.0f);
} 
